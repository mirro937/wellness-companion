# =============================================================================
# رفيقك (Rafiqak) — Environment Configuration Template
# =============================================================================

# Server
NODE_ENV=development
PORT=3000
APP_NAME=rafiqak-api
FRONTEND_URL=http://localhost:8081

# PostgreSQL Database (16)
POSTGRES_USER=rafiqak_admin
POSTGRES_PASSWORD=rafiqak_secure_pass_2026
POSTGRES_DB=rafiqak_db
DATABASE_URL=postgresql://rafiqak_admin:rafiqak_secure_pass_2026@localhost:5432/rafiqak_db?schema=public

# Redis (7.2)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_secure_pass_2026

# JWT Security
JWT_ACCESS_SECRET=super_secret_access_key_change_in_production_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super_secret_refresh_key_change_in_production_min_32_chars
JWT_REFRESH_EXPIRES_IN=30d

# Google Gemini 2.0 API (Multimodal Vision & Live Voice)
GEMINI_API_KEY=your_gemini_2_0_api_key_here
GEMINI_MODEL_VISION=gemini-2.0-flash

# Object Storage (Cloudflare R2 or MinIO)
# For local development: http://localhost:9000
# For production (Cloudflare R2): https://<account_id>.r2.cloudflarestorage.com
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_ACCESS_KEY=minio_admin
S3_SECRET_KEY=minio_secure_key_2026
S3_BUCKET_NAME=rafiqak-meal-photos

# Egyptian SMS Gateway (VictoryLink / Twilio / Infobip)
SMS_GATEWAY_PROVIDER=victorylink
SMS_GATEWAY_USERNAME=your_username
SMS_GATEWAY_PASSWORD=your_password
SMS_GATEWAY_SENDER_ID=Rafiqak
SMS_GATEWAY_API_KEY=your_sms_api_key

# Payment Gateways (Fawry / Paymob)
PAYMOB_API_KEY=your_paymob_api_key
PAYMOB_INTEGRATION_ID=your_integration_id
PAYMOB_HMAC_SECRET=your_paymob_hmac_secret
